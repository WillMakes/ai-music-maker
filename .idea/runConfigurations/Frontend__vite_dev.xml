<component name="ProjectRunConfigurationManager">
  <!-- Vite on its own, for working on layout and styling without launching a
       window. Binding calls reject in a plain browser (no Wails runtime), which
       the frontend is written to survive: loadSetting returns null and
       useDataChanged simply never fires. -->
  <configuration default="false" name="Frontend: vite dev" type="js.build_tools.npm">
    <package-json value="$PROJECT_DIR$/frontend/package.json" />
    <command value="run" />
    <scripts>
      <script value="dev" />
    </scripts>
    <node-interpreter value="project" />
    <envs />
    <method v="2" />
  </configuration>
</component>
