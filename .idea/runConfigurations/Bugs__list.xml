<component name="ProjectRunConfigurationManager">
  <!-- The bug queue from inside the IDE, without leaving for a terminal. Runs
       against the source rather than build/bin so it reflects the working tree —
       the queue is a projection of the repository's issue list, and reading it
       through a stale binary would be reading it through a stale reconcile. -->
  <configuration default="false" name="Bugs: list" type="ShConfigurationType">
    <option name="SCRIPT_TEXT" value="go run . bugs list" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="powershell.exe" />
    <option name="INTERPRETER_OPTIONS" value="-NoProfile -Command" />
    <option name="EXECUTE_IN_TERMINAL" value="true" />
    <option name="EXECUTE_SCRIPT_FILE" value="false" />
    <envs />
    <method v="2" />
  </configuration>
</component>
