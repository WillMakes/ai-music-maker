<?xml version="1.0" encoding="UTF-8"?>
<module type="WEB_MODULE" version="4">
  <component name="Go" enabled="true" />
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$/..">
      <!-- Excluded from indexing: node_modules is tens of thousands of files,
           frontend/dist and build/bin are output, and wailsjs is generated by
           `wails build` on every run. Indexing any of them makes Find Usages
           answer with generated copies of the thing being searched for. -->
      <excludeFolder url="file://$MODULE_DIR$/../frontend/node_modules" />
      <excludeFolder url="file://$MODULE_DIR$/../frontend/dist" />
      <excludeFolder url="file://$MODULE_DIR$/../frontend/wailsjs" />
      <excludeFolder url="file://$MODULE_DIR$/../build/bin" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
</module>
