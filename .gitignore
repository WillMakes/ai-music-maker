# Build output
build/bin/
frontend/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Node
frontend/node_modules/
frontend/package.json.md5

# Wails generates these from the Go bindings on every build. Committed nowhere:
# they are output, and a stale copy in a diff is noise that hides a real change.
frontend/wailsjs/

# Go
*.test
*.out
vendor/

# Editor state. The run configurations under .idea/ ARE committed — they are how
# the project is run — so this is deliberately a list of files rather than the
# whole folder.
.idea/*
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/usage.statistics.xml
.idea/dictionaries/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Claude.MD
claude.md

# Wails writes these next to the committed project.nsi on every -nsis build.
build/windows/installer/wails_tools.nsh
build/windows/installer/tmp/
